[Unit]
Description=OpenVibe Locker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=openvibe
Group=openvibe
WorkingDirectory=/opt/openvibe/OpenVibe.Locker
Environment=NODE_ENV=production
Environment=PORT=5145
Environment=HOST=127.0.0.1
Environment=LOCKER_DATA_DIR=/var/lib/openvibe/locker
EnvironmentFile=/etc/openvibe/locker.env
ExecStart=/usr/bin/node server/index.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=1800
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/openvibe/locker
UMask=0077

[Install]
WantedBy=multi-user.target
